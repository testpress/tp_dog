        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(sum by (instance) (rate({__name__=~\"otelcol_receiver_refused_spans.*|otelcol_exporter_send_failed_spans.*|otelcol_processor_dropped_spans.*\", instance=~\"$instance\"}[$__rate_interval])) > 0) or vector(0)",
