          "legendFormat": "",
          "range": false,
          "refId": "Status"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(rate({__name__=~\"otelcol_process_cpu_seconds.*\", instance=~\"$instance\"}[$__rate_interval]) / 0.5) * 100",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "CPU"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "otelcol_process_memory_rss{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "Memory"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (rate({__name__=~\"otelcol_receiver_accepted_spans.*\", instance=~\"$instance\"}[$__rate_interval])) or (0 * otelcol_process_uptime{instance=~\"$instance\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "Ingest"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (rate({__name__=~\"otelcol_exporter_sent_spans.*\", instance=~\"$instance\"}[$__rate_interval])) or (0 * otelcol_process_uptime{instance=~\"$instance\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "Export"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(otelcol_exporter_queue_size{exporter=~\"(?i).*tempo.*\", instance=~\"$instance\"} / otelcol_exporter_queue_capacity{exporter=~\"(?i).*tempo.*\", instance=~\"$instance\"}) * 100 or (0 * otelcol_process_uptime{instance=~\"$instance\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "Queue"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "otelcol_process_uptime{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "Uptime"
        }
