          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "🔴 Down",
                        "color": "red",
                        "index": 1
                      },
                      "1": {
                        "text": "🟢 Healthy",
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 1,
                      "to": 999999999,
                      "result": {
                        "text": "🟢 Healthy",
                        "color": "green",
                        "index": 2
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": -999999999,
                      "to": 0,
                      "result": {
                        "text": "🔴 Down",
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
