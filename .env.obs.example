# ==============================================================================
# tp_trace - OBSERVABILITY server environment (production)
# ==============================================================================
# Copy to `.env` on the observability host, then edit:
#   cp .env.obs.example .env
#
# Do NOT set these on the app server - this file is only read by
# docker-compose.obs.yml.
# ==============================================================================

# --- Tempo -------------------------------------------------------------------
# Host port that accepts OTLP/gRPC pushes from the app server's collector.
# The app server's collector must be able to reach this host on this port.
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318
# Tempo query API (Grafana + operators).
TEMPO_QUERY_PORT=3200
TEMPO_MEMORY_LIMIT=2G

# --- Prometheus --------------------------------------------------------------
PROMETHEUS_PORT=9090
# Must be <= Tempo's block_retention (336h / 14d) so exemplars and metrics
# line up over the window the dashboards assume.
PROMETHEUS_RETENTION=15d
PROMETHEUS_MEMORY_LIMIT=2G

# --- Grafana -----------------------------------------------------------------
GRAFANA_PORT=3000
# Anonymous Admin access is on by default (it is a dev convenience). Turn the
# login form off once a real admin password is set.
GF_AUTH_DISABLE_LOGIN_FORM=false
GF_SECURITY_ADMIN_PASSWORD=change-me-before-going-live