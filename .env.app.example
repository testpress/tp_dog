# ==============================================================================
# tp_dog - APP server environment (production)
# ==============================================================================
# Copy to `.env` on the app server, then edit:
#   cp .env.app.example .env
#
# Read by docker-compose.yml (the app stack + OTel Collector).
# Do NOT set these on the observability server.
# ==============================================================================

# --- Telemetry export --------------------------------------------------------
# gRPC endpoint of the Tempo instance on the OBSERVABILITY server.
# This is the one URL that must change when you split the topology.
# Must be resolvable and reachable from the app host. Do NOT use the Docker
# service name `tempo` here - that only resolves on a shared Docker network.
TEMPO_OTLP_ENDPOINT=tempo.obs.internal:4317

# `true` for plaintext gRPC (the default deployment). Set to `false` and point
# TLS at real certificates before sending traces across an untrusted network.
TEMPO_OTLP_INSECURE=true