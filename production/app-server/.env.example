# ==============================================================================
# TraceNest - APP SERVER CONFIGURATION (PRODUCTION)
# ==============================================================================
# Copy this file to .env on the App Server:
#   cp .env.example .env
# ==============================================================================

# --- Observability Target ----------------------------------------------------
# gRPC endpoint of the Tempo instance on the OBSERVABILITY SERVER.
# Must be resolvable and reachable from the app host.
# Example: 10.0.1.50:4317 or tempo.obs.internal:4317
TEMPO_OTLP_ENDPOINT=<OBSERVABILITY_SERVER_IP_OR_DNS>:4317

# Set to `true` for plaintext gRPC within private VPC / internal network.
# Set to `false` if using TLS certificates across an untrusted network.
TEMPO_OTLP_INSECURE=true
