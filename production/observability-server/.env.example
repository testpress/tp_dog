# ==============================================================================
# TraceNest - OBSERVABILITY SERVER CONFIGURATION (PRODUCTION)
# ==============================================================================
# Copy this file to .env on the observability server:
#   cp .env.example .env
#
# Generate a secure secret key before starting:
#   openssl rand -hex 32
# ==============================================================================

# --- Network & Bind IP Security -----------------------------------------------
# In production, bind internal services to your private IP or 127.0.0.1.
# TEMPO_BIND_IP: IP that accepts traces from App Servers (e.g. 10.0.1.50 or 0.0.0.0 with SG)
TEMPO_BIND_IP=0.0.0.0
# TEMPO_QUERY_BIND_IP: Tempo query port (Grafana uses Docker network; 127.0.0.1 is safest)
TEMPO_QUERY_BIND_IP=127.0.0.1
# PROMETHEUS_BIND_IP: Prometheus web/API (Grafana uses Docker network; 127.0.0.1 prevents unauthenticated public access)
PROMETHEUS_BIND_IP=127.0.0.1
# GRAFANA_BIND_IP: Grafana UI (0.0.0.0 or 127.0.0.1 if behind Nginx/ALB reverse proxy)
GRAFANA_BIND_IP=0.0.0.0

# --- Tempo (Trace Storage) ----------------------------------------------------
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318
TEMPO_QUERY_PORT=3200
TEMPO_MEMORY_LIMIT=2G
TEMPO_MEMORY_RESERVATION=512M
TEMPO_CPU_LIMIT=2.0
TEMPO_CPU_RESERVATION=0.5

# --- Prometheus (Metrics TSDB) ------------------------------------------------
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=20GB
PROMETHEUS_MEMORY_LIMIT=2G
PROMETHEUS_MEMORY_RESERVATION=512M
PROMETHEUS_CPU_LIMIT=2.0
PROMETHEUS_CPU_RESERVATION=0.5

# --- Grafana (Visualization UI) -----------------------------------------------
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
# REQUIRED: Set a strong admin password and unique secret key for session cookies:
GF_SECURITY_ADMIN_PASSWORD=change-me-to-a-secure-password
GF_SECURITY_SECRET_KEY=change-me-to-a-random-hex-string-using-openssl-rand-hex-32
# Security defaults (Do NOT enable anonymous admin in production)
GF_AUTH_ANONYMOUS_ENABLED=false
GF_SECURITY_ALLOW_EMBEDDING=false
GF_SECURITY_COOKIE_SECURE=false
GF_SERVER_ROOT_URL=http://localhost:3000/
GRAFANA_MEMORY_LIMIT=1G
GRAFANA_MEMORY_RESERVATION=256M
GRAFANA_CPU_LIMIT=1.5
GRAFANA_CPU_RESERVATION=0.25
